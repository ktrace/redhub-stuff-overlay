Backport of the upstream sol2 fix (develop) for the full class
specialization sol::optional<T&>::emplace(), which called the
nonexistent this->construct() and is rejected by GCC 13+ (-Wtemplate-body).
Rebinds m_value to the referenced object instead.

--- a/include/sol/optional_implementation.hpp
+++ b/include/sol/optional_implementation.hpp
@@ -2186,12 +2186,10 @@
 		/// one.
 		///
 		/// \group emplace
-		template <class... Args>
-		T& emplace(Args&&... args) noexcept {
-			static_assert(std::is_constructible<T, Args&&...>::value, "T must be constructible with Args");
-
+		T& emplace(T& arg) noexcept {
 			*this = nullopt;
-			this->construct(std::forward<Args>(args)...);
+			m_value = &arg;
+			return **this;
 		}
 
 		/// Swaps this optional with the other.
